      avg by (project_id) (
        kubernetes_io:node_cpu_allocatable_utilization
      ) * 100,
      "service", "GKE Nodes", "project_id", ".*"
    ),
    "metric_type", "CPU", "project_id", ".*"
  )
or
  label_replace(
    label_replace(
      avg by (project_id) (
