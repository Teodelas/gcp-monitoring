# ==========================================
# 1. COMPUTE ENGINE (OPS AGENT)
# ==========================================
  label_replace(
    label_replace(
      avg by (project_id) (
        sum by (project_id, instance_id) (
          agent_googleapis_com:cpu_utilization{monitored_resource="gce_instance", cpu_state!="idle"}
        )
      ),
      "service", "Compute Engine", "project_id", ".*"
    ),
    "metric_type", "CPU", "project_id", ".*"
  )
or
  label_replace(
    label_replace(
      avg by (project_id) (
        sum by (project_id, instance_id) (
          agent_googleapis_com:memory_percent_used{monitored_resource="gce_instance", state="used"}
        )
      ),
      "service", "Compute Engine", "project_id", ".*"
    ),
    "metric_type", "Memory", "project_id", ".*"
  )
or
  label_replace(
    label_replace(
      avg by (project_id) (
        max by (project_id, instance_id) (
          agent_googleapis_com:disk_percent_used{monitored_resource="gce_instance", state="used"}
        )
      ),
      "service", "Compute Engine", "project_id", ".*"
    ),
    "metric_type", "Storage", "project_id", ".*"
  )

# ==========================================
# 2. CLOUD SQL
# ==========================================
or
  label_replace(
    label_replace(
      avg by (project_id) (
        cloudsql_googleapis_com:database_cpu_utilization
      ) * 100,
      "service", "Cloud SQL", "project_id", ".*"
    ),
    "metric_type", "CPU", "project_id", ".*"
  )
or
  label_replace(
    label_replace(
      avg by (project_id) (
        cloudsql_googleapis_com:database_memory_utilization
      ) * 100,
      "service", "Cloud SQL", "project_id", ".*"
    ),
    "metric_type", "Memory", "project_id", ".*"
  )
or
  label_replace(
    label_replace(
      avg by (project_id) (
        cloudsql_googleapis_com:database_disk_utilization
      ) * 100,
      "service", "Cloud SQL", "project_id", ".*"
    ),
    "metric_type", "Storage", "project_id", ".*"
  )

